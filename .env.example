# This file is an example. Copy it to a new file named .env (in the repo root)
# and fill in your actual credentials.
#
# NOTE: DATABASE_URL is managed by docker-compose.yml (PostgreSQL in the db
# service) and should NOT be set in this file.

# PostgreSQL credentials (OPTIONAL). Only override if needed; defaults match
# docker-compose.yml. Changing these after first boot requires
# `docker compose down -v` to recreate the database volume. Passwords must not
# contain URL-special characters (@ : / ? #) because they are interpolated
# into DATABASE_URL.
# POSTGRES_USER="spotifytracker"
# POSTGRES_PASSWORD="spotifytracker"
# POSTGRES_DB="spotify_tracker"

# Spotify API Credentials (REQUIRED)
SPOTIPY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"
SPOTIPY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET"

# Spotify redirect URI. The default works for local Docker Compose runs;
# uncomment and change only if you use a custom domain/tunnel.
# SPOTIPY_REDIRECT_URI="http://127.0.0.1:8888/callback"

# CORS origins (comma-separated). The default works for local Docker Compose
# runs; uncomment and change only if you use a custom domain/tunnel.
# CORS_ORIGINS="http://127.0.0.1:8888"

# Flask secret key for session management (OPTIONAL).
# If blank, a random key is generated on first start and persisted in the
# trackify-data volume (/data/.secret), so sessions survive restarts.
# You can generate a good one by running this in a Python shell:
# import os; print(os.urandom(24).hex())
FLASK_SECRET_KEY=""
